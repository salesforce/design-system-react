{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "outDir": "dist/types",
    "rootDir": ".",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noImplicitAny": false
  },
  "include": ["components/**/*", "utilities/**/*", "types/**/*"],
  "exclude": ["**/*.test.*", "**/*.spec.*", "**/*.browser-test.*", "**/*.browser.test.*", "**/__tests__/**", "**/__examples__/**", "**/__docs__/**", "node_modules", "dist", "**/site-stories.js"]
}
