{
  "name": "design-system-react",
  "version": "0.10.64",
  "description": "Salesforce Lightning Design System for React",
  "type": "module",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:browser": "vitest --project browser",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "start": "npm run dev",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "prepack": "npm run build"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/salesforce/design-system-react.git"
  },
  "keywords": [
    "react",
    "slds",
    "salesforce",
    "salesforce-ux",
    "lightning",
    "design system",
    "lightning design system",
    "salesforce-lightning",
    "salesforce lightning design system",
    "interactive components",
    "interactive",
    "components"
  ],
  "bugs": {
    "url": "https://github.com/salesforce/design-system-react/issues"
  },
  "main": "dist/design-system-react.cjs",
  "module": "dist/design-system-react.es.js",
  "types": "dist/types/components/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt",
    "RELEASENOTES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/design-system-react.es.js",
      "require": "./dist/design-system-react.cjs",
      "default": "./dist/design-system-react.es.js"
    }
  },
  "homepage": "https://react.lightningdesignsystem.com",
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@salesforce-ux/design-system-2": "^2.264.1",
    "classnames": "^2.5.1",
    "column-resizer": "^1.3.6",
    "dequal": "^2.0.3",
    "lodash.assign": "^4.2.0",
    "lodash.escaperegexp": "^4.1.2",
    "lodash.find": "^4.6.0",
    "lodash.findindex": "^4.6.0",
    "lodash.isdate": "^4.0.1",
    "lodash.isfunction": "^3.0.9",
    "lodash.reject": "^4.6.0",
    "memoize-one": "^6.0.0",
    "nanoid": "^6.0.1",
    "prop-types": "^15.8.1",
    "react-contenteditable": "^3.3.7",
    "react-highlighter-ts": "^2.2.0",
    "react-modal": "^3.16.1",
    "warning": "^4.0.3"
  },
  "peerDependencies": {
    "@salesforce-ux/design-system": "2.25.0-alpha.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@salesforce-ux/design-system": "2.25.0-alpha.2",
    "@salesforce-ux/icons": "10.x",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/lodash.assign": "^4.2.9",
    "@types/lodash.escaperegexp": "^4.1.9",
    "@types/lodash.find": "^4.6.9",
    "@types/lodash.findindex": "^4.6.9",
    "@types/lodash.isdate": "^4.0.9",
    "@types/lodash.isfunction": "^3.0.9",
    "@types/lodash.reject": "^4.6.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.5",
    "@types/react-modal": "^3.16.3",
    "@types/warning": "^3.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vueless/storybook-dark-mode": "^10.0.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^17.11.0",
    "jsdom": "^30.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.2.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.2.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "eslint-plugin-react": {
      "eslint": "^10.0.0"
    }
  }
}
