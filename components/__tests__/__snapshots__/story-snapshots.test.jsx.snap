exports[`Story HTML snapshots > Alert > AllVariants 1`] = `
"<div class="slds-p-around_medium slds-p-top_xx-large">
  <div style="display:flex;flex-direction:column;gap:1rem">
    <div class="slds-notify slds-notify_alert slds-theme_alert-texture slds-theme_info" role="alert"><span class="slds-assistive-text">info</span><span class="slds-m-right_x-small"><svg class="slds-icon slds-icon_x-small" aria-hidden="true">
          <use href="/assets/icons/utility-sprite/svg/symbols.svg#info"></use>
        </svg></span>
      <h2>Info: Neutral information message </h2>
    </div>
    <div class="slds-notify slds-notify_alert slds-theme_alert-texture slds-theme_warning" role="alert"><span class="slds-assistive-text">warning</span><span class="slds-m-right_x-small"><svg class="slds-icon slds-icon_x-small" aria-hidden="true">
          <use href="/assets/icons/utility-sprite/svg/symbols.svg#warning"></use>
        </svg></span>
      <h2>Warning: Please pay attention to this </h2>
    </div>
    <div class="slds-notify slds-notify_alert slds-theme_alert-texture slds-theme_error" role="alert"><span class="slds-assistive-text">error</span><span class="slds-m-right_x-small"><svg class="slds-icon slds-icon_x-small" aria-hidden="true">
          <use href="/assets/icons/utility-sprite/svg/symbols.svg#error"></use>
        </svg></span>
      <h2>Error: Something went wrong </h2>
    </div>
    <div class="slds-notify slds-notify_alert slds-theme_alert-texture slds-theme_offline" role="alert"><span class="slds-assistive-text">offline</span><span class="slds-m-right_x-small"><svg class="slds-icon slds-icon_x-small" aria-hidden="true">
          <use href="/assets/icons/utility-sprite/svg/symbols.svg#offline"></use>
        </svg></span>
      <h2>Offline: No internet connection </h2>
    </div>
  </div>
</div>"
`;

