{
	// Repo tooling in `scripts/` (run with `tsx`). The build config only covers
	// `components/`, `utilities/` and `types/`; `npm run typecheck` runs this too.
	"extends": "./tsconfig.json",
	// `check-package-exports.mjs` runs on plain `node`, which needs the `.ts`
	// extension to import a sibling TypeScript module.
	"compilerOptions": {
		"lib": ["ES2022"],
		"types": ["node"],
		"allowImportingTsExtensions": true
	},
	"include": ["scripts/**/*.ts"],
	"exclude": ["node_modules", "dist", ".tmp-npm"]
}
